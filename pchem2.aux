\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Color gradient maps of the real part $(\Re [Y_\ell ^{m_\ell }(\theta ,\phi )])$ for spherical harmonics of the rigid rotor. Color scheme: Red (positive), blue (negative), white/light (nodal lines where $Y_\ell ^{m_\ell }=0$). Each $\ell $ manifold shows characteristic nodal structure: 0 nodal lines $(\ell =0)$, 1 nodal surface $(\ell =1)$, 2 nodal surfaces $(\ell =2)$.}}{72}{figure.caption.22}\protected@file@percent }
\newlabel{fig:fig6c4}{{4.7}{72}{Color gradient maps of the real part $(\Re [Y_\ell ^{m_\ell }(\theta ,\phi )])$ for spherical harmonics of the rigid rotor. Color scheme: Red (positive), blue (negative), white/light (nodal lines where $Y_\ell ^{m_\ell }=0$). Each $\ell $ manifold shows characteristic nodal structure: 0 nodal lines $(\ell =0)$, 1 nodal surface $(\ell =1)$, 2 nodal surfaces $(\ell =2)$}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Color gradient maps of the imaginary part $(\Im [Y_\ell ^{m_\ell }(\theta ,\phi )])$ for spherical harmonics of the rigid rotor. Color scheme: Red (positive), blue (negative), white/light (nodal lines where $Y_\ell ^{m_\ell }=0$). Each $\ell $ manifold shows characteristic nodal structure: 0 nodal lines ($\ell =0$), 1 nodal surface ($\ell =1$), 2 nodal surfaces ($\ell =2$).}}{73}{figure.caption.23}\protected@file@percent }
\newlabel{fig:fig7c4}{{4.8}{73}{Color gradient maps of the imaginary part $(\Im [Y_\ell ^{m_\ell }(\theta ,\phi )])$ for spherical harmonics of the rigid rotor. Color scheme: Red (positive), blue (negative), white/light (nodal lines where $Y_\ell ^{m_\ell }=0$). Each $\ell $ manifold shows characteristic nodal structure: 0 nodal lines ($\ell =0$), 1 nodal surface ($\ell =1$), 2 nodal surfaces ($\ell =2$)}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces Probability density plots $|Y_\ell ^{m_\ell }(\theta ,\phi )|^2$ for spherical harmonics of the rigid rotor. Color scheme: Darker colors indicate higher probability density on the surface of the sphere. Unlike the particle on a ring (uniform $|\psi |^2$), these show non-uniform angular probability: $(\ell =0)$ uniform; $(\ell =1)$ states peak at poles/equator; $(\ell =2)$ states show complex 4-lobed or toroidal patterns. Probability integrates to 1 over sphere surface for each state.}}{74}{figure.caption.24}\protected@file@percent }
\newlabel{fig:fig8c4}{{4.9}{74}{Probability density plots $|Y_\ell ^{m_\ell }(\theta ,\phi )|^2$ for spherical harmonics of the rigid rotor. Color scheme: Darker colors indicate higher probability density on the surface of the sphere. Unlike the particle on a ring (uniform $|\psi |^2$), these show non-uniform angular probability: $(\ell =0)$ uniform; $(\ell =1)$ states peak at poles/equator; $(\ell =2)$ states show complex 4-lobed or toroidal patterns. Probability integrates to 1 over sphere surface for each state}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces Parametric plots of the real part of the spherical harmonics $Y_\ell ^{m_\ell }(\theta ,\phi )$. The radial deformation (distance from the center at a given angle) is proportional to $\Re [Y_\ell ^{m_\ell }(\theta ,\phi )]$ (larger lobes = higher angular probability). The color indicates sign of real part (red=positive, blue=negative). The nodal surfaces are also reported in purple. Note: The particle remains confined to a constant sphere surface; the lobes visualize angular probability structure, not 3D spatial extent.}}{75}{figure.caption.25}\protected@file@percent }
\newlabel{fig:fig9c4}{{4.10}{75}{Parametric plots of the real part of the spherical harmonics $Y_\ell ^{m_\ell }(\theta ,\phi )$. The radial deformation (distance from the center at a given angle) is proportional to $\Re [Y_\ell ^{m_\ell }(\theta ,\phi )]$ (larger lobes = higher angular probability). The color indicates sign of real part (red=positive, blue=negative). The nodal surfaces are also reported in purple. Note: The particle remains confined to a constant sphere surface; the lobes visualize angular probability structure, not 3D spatial extent}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces Parametric plots of the imaginary part of the spherical harmonics $Y_\ell ^{m_\ell }(\theta ,\phi )$. The radial deformation (distance from the center at a given angle) is proportional to $\Im [Y_\ell ^{m_\ell }(\theta ,\phi )]$ (larger lobes = higher angular probability). The color indicates sign of imaginary part (red=positive, blue=negative). The nodal surfaces are also reported in purple. Note: The particle remains confined to a constant sphere surface; the lobes visualize angular probability structure, not 3D spatial extent.}}{76}{figure.caption.26}\protected@file@percent }
\newlabel{fig:fig10c4}{{4.11}{76}{Parametric plots of the imaginary part of the spherical harmonics $Y_\ell ^{m_\ell }(\theta ,\phi )$. The radial deformation (distance from the center at a given angle) is proportional to $\Im [Y_\ell ^{m_\ell }(\theta ,\phi )]$ (larger lobes = higher angular probability). The color indicates sign of imaginary part (red=positive, blue=negative). The nodal surfaces are also reported in purple. Note: The particle remains confined to a constant sphere surface; the lobes visualize angular probability structure, not 3D spatial extent}{figure.caption.26}{}}
