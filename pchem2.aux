\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces A narrow (top) and a wide (bottom) wave packet in position space (left), together with the corresponding distributions of wave vectors, and therefore of momenta (right). The more localized the particle is in space, the broader its distribution of momenta.}}{45}{figure.caption.14}\protected@file@percent }
\newlabel{fig:fig3c3}{{3.3}{45}{A narrow (top) and a wide (bottom) wave packet in position space (left), together with the corresponding distributions of wave vectors, and therefore of momenta (right). The more localized the particle is in space, the broader its distribution of momenta}{figure.caption.14}{}}
