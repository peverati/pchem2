\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Top-down 2D contour plots of particle-on-a-ring eigenfunctions $\psi _{m_\ell }(\phi ) = \frac  {1}{\sqrt  {2\pi }} e^{i m_\ell \phi }$. Left column: Real part $\Re [\psi _{m_\ell }] = \frac  {1}{\sqrt  {2\pi }}\cos (m_\ell \phi )$. Right column: Imaginary part $\Im [\psi _{m_\ell }] = \frac  {1}{\sqrt  {2\pi }}\sin (m_\ell \phi )$. Each row shows states with quantum numbers $m_\ell = 0, +1, -1, +2, -2$. Color scheme: Dark red (positive amplitude), dark blue (negative amplitude), white/light colors (nodes $\approx $ 0). Each component shows exactly $2|m_\ell |$ nodal points appearing as diametrically opposite pairs due to rotational symmetry.}}{67}{figure.caption.19}\protected@file@percent }
\newlabel{fig:fig3c4}{{4.4}{67}{Top-down 2D contour plots of particle-on-a-ring eigenfunctions $\psi _{m_\ell }(\phi ) = \frac {1}{\sqrt {2\pi }} e^{i m_\ell \phi }$. Left column: Real part $\Re [\psi _{m_\ell }] = \frac {1}{\sqrt {2\pi }}\cos (m_\ell \phi )$. Right column: Imaginary part $\Im [\psi _{m_\ell }] = \frac {1}{\sqrt {2\pi }}\sin (m_\ell \phi )$. Each row shows states with quantum numbers $m_\ell = 0, +1, -1, +2, -2$. Color scheme: Dark red (positive amplitude), dark blue (negative amplitude), white/light colors (nodes $\approx $ 0). Each component shows exactly $2|m_\ell |$ nodal points appearing as diametrically opposite pairs due to rotational symmetry}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Polar plots of particle-on-a-ring eigenfunctions $\psi _{m_\ell }(\phi ) = \frac  {1}{\sqrt  {2\pi }} e^{i m_\ell \phi }$. Left column: Real part $\Re [\psi _{m_\ell }] = \frac  {1}{\sqrt  {2\pi }}\cos (m_\ell \phi )$. Right column: Imaginary part $\Im [\psi _{m_\ell }] = \frac  {1}{\sqrt  {2\pi }}\sin (m_\ell \phi )$. Each row shows states with quantum numbers $m_\ell = 0, +1, -1, +2, -2$. Radial distance from center $\propto $ wavefunction amplitude; angular position = $\phi $. Nodes appear where the curve returns to the origin ($2|m_\ell |$ per component). Note: Lobes represent amplitude along the ring, not 2D spatial probability (actual $|\psi |^2$ is uniform).}}{68}{figure.caption.20}\protected@file@percent }
\newlabel{fig:fig4c4}{{4.5}{68}{Polar plots of particle-on-a-ring eigenfunctions $\psi _{m_\ell }(\phi ) = \frac {1}{\sqrt {2\pi }} e^{i m_\ell \phi }$. Left column: Real part $\Re [\psi _{m_\ell }] = \frac {1}{\sqrt {2\pi }}\cos (m_\ell \phi )$. Right column: Imaginary part $\Im [\psi _{m_\ell }] = \frac {1}{\sqrt {2\pi }}\sin (m_\ell \phi )$. Each row shows states with quantum numbers $m_\ell = 0, +1, -1, +2, -2$. Radial distance from center $\propto $ wavefunction amplitude; angular position = $\phi $. Nodes appear where the curve returns to the origin ($2|m_\ell |$ per component). Note: Lobes represent amplitude along the ring, not 2D spatial probability (actual $|\psi |^2$ is uniform)}{figure.caption.20}{}}
